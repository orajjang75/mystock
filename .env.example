# Copy to .env and edit. .env is git-ignored; never commit real secrets.

# PostgreSQL (docker-compose.yml reads these)
POSTGRES_USER=mystock
POSTGRES_PASSWORD=mystock
POSTGRES_DB=mystock
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://mystock:mystock@localhost:5432/mystock
APP_USERNAME=admin
APP_PASSWORD=change-me
# At least 32 characters. Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-me-to-a-random-string-of-32-chars-or-more
# mock | pykrx | kis
ADAPTER=mock
# Set true when served over HTTPS
COOKIE_SECURE=false
# Include preferred shares (우선주) in the scan universe
UNIVERSE_INCLUDE_PREFERRED=false
# Seed for the mock market-data adapter
MOCK_SEED=42
# KRX data-portal account, required by the pykrx adapter (ADAPTER=pykrx)
KRX_ID=
KRX_PW=
# Daily scan start time (KST). Must be after the investor-flow data is final (PRD 오픈 이슈).
# KIS publishes the day's 투자자별 매매동향 after the close; 18:30 leaves room (docs/real-data.md).
DAILY_SCAN_TIME=18:00

# Scheduler: run the daily and per-bar jobs inside the API process (use ONE worker).
# docker compose turns this on by itself; set it here only for a local `uvicorn` run.
SCHEDULER_ENABLED=false
# 모의 운영 (paper run): real quotes and signals, but fills and cycle decisions are refused (409).
# Run it for a few weeks and read the daily report (GET /api/ops/report, docs/real-data.md).
PAPER_RUN=false
# Telegram bot for alerts outside the app (switch the channel on in the settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 한국투자증권 KIS Open API (ADAPTER=kis). Keys only here, never in code or logs.
# Issue them at https://apiportal.koreainvestment.com (real keys for real quotes).
KIS_APP_KEY=
KIS_APP_SECRET=
# real | paper (모의투자 server; its minute data and rate limit differ, see docs/real-data.md)
KIS_ENV=real
# Calls per second to stay under. Empty = the safe default of the chosen KIS_ENV.
KIS_MAX_RPS=
# Where the 24h access token is cached so a restart does not re-issue it (one issue per minute).
# docker compose overrides this with a volume path.
KIS_TOKEN_FILE=~/.mystock/kis_token.json

# docker compose: the port the screens are served on (http://localhost:8080)
WEB_PORT=8080
