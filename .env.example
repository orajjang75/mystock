# Copy to .env and edit. .env is git-ignored; never commit real secrets.

# PostgreSQL (docker-compose.yml reads these)
POSTGRES_USER=mystock
POSTGRES_PASSWORD=mystock
POSTGRES_DB=mystock
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://mystock:mystock@localhost:5432/mystock
APP_USERNAME=admin
APP_PASSWORD=change-me
# At least 32 characters. Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-me-to-a-random-string-of-32-chars-or-more
# mock | pykrx | kis
ADAPTER=mock
# Set true when served over HTTPS
COOKIE_SECURE=false
# Include preferred shares (우선주) in the scan universe
UNIVERSE_INCLUDE_PREFERRED=false
# Seed for the mock market-data adapter
MOCK_SEED=42
# KRX data-portal account, required by the pykrx adapter (ADAPTER=pykrx)
KRX_ID=
KRX_PW=
# Daily scan start time (KST). Must be after the investor-flow data is final (PRD 오픈 이슈).
DAILY_SCAN_TIME=18:00

# Scheduler: run the daily and per-bar jobs inside the API process (use ONE worker)
SCHEDULER_ENABLED=false
# Telegram bot for alerts outside the app (switch the channel on in the settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Broker API keys (step 11)
KIS_APP_KEY=
KIS_APP_SECRET=
